import { ListView, Spinner } from "std-widgets.slint";
import { Palette, Icons } from "theme.slint";
import { Icon, IconButton, Chip, PillButton, Cover, Bar, ListRow, Card, InputField, EqBars } from "widgets.slint";

export struct TrackItem { title: string, subtitle: string, trailing: string, playing: bool, art: image, has-art: bool }
export struct GroupItem { name: string, info: string, art: image, has-art: bool }
export struct OnlineItem { title: string, subtitle: string, state: int, art: image, has-art: bool }
export struct DownloadItem { title: string, status: string, progress: float, state: int }

export global State {
    // Library
    in-out property <int> lib-view: 0;
    in-out property <string> lib-query;
    in property <[TrackItem]> tracks;
    in property <[GroupItem]> groups;
    in property <string> group-title;
    in property <image> group-art;
    in property <bool> has-group-art;
    in property <string> library-status;
    callback lib-filter(string);
    callback lib-view-changed(int);
    callback track-clicked(int);
    callback track-menu(int);
    callback group-clicked(int);
    callback group-menu(int);
    callback current-group-menu();
    callback group-back();
    callback play-all(bool);
    callback rescan();
    // Online search (state: 0 = available, 1 = queued, 2 = downloading, 3 = done, 4 = error)
    in-out property <string> online-query;
    in property <[OnlineItem]> online;
    in property <string> online-status;
    in property <bool> online-busy;
    callback online-search(string);
    callback online-download(int);
    callback online-download-all();
    // Downloads (state: 0 = waiting, 1 = running, 2 = done, 3 = error)
    in property <[DownloadItem]> downloads;
    in property <int> active-downloads;
    callback clear-downloads();
    // Player
    in property <bool> has-current;
    in property <string> now-title;
    in property <string> now-artist;
    in property <string> now-album;
    in property <image> now-cover;
    in property <bool> has-cover;
    in property <color> now-tint: Palette.accent.darker(110%);
    in property <bool> playing;
    in property <float> position;
    in property <float> duration;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <bool> shuffle;
    in property <int> repeat-mode;
    in property <float> volume: 1;
    in property <bool> current-fav;
    in property <[TrackItem]> queue;
    callback toggle-play();
    callback next();
    callback prev();
    callback seek(float);
    callback set-volume(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-fav();
    callback current-menu();
    callback queue-jump(int);
    callback queue-menu(int);
    // Sheets and dialogs
    in-out property <bool> menu-open;
    in property <string> menu-title;
    in property <[string]> menu-options;
    callback menu-action(int);
    in-out property <bool> edit-open;
    in property <bool> edit-saving;
    in-out property <string> edit-title;
    in-out property <string> edit-artist;
    in-out property <string> edit-album;
    callback save-edit();
    // 0 = song, 1 = album, 2 = artist, 3 = playlist
    in property <int> edit-mode;
    // Settings
    in property <string> download-dir;
    callback change-download-dir();
    callback set-theme(int);
    in property <[float]> eq: [0, 0, 0, 0, 0];
    in property <[string]> eq-presets;
    in property <int> eq-preset: 0;
    callback set-eq(int, float);
    callback set-eq-preset(int);
    in-out property <bool> chooser-open;
    in property <[string]> playlist-names;
    callback choose-playlist(int);
    in-out property <bool> name-dialog-open;
    callback create-playlist(string);
    in property <string> toast;
}

component PageTitle inherits HorizontalLayout {
    in property <string> title;
    in property <bool> logo;
    in property <length> pad: 16px;
    padding-left: pad;
    padding-right: pad - 8px;
    height: 64px;
    spacing: 10px;
    if root.logo: Image {
        source: @image-url("../docs/logo.png");
        width: 32px;
        height: 32px;
        y: (parent.height - self.height) / 2;
    }
    Text {
        text: root.title;
        color: Palette.text;
        font-size: 28px;
        font-weight: 800;
        vertical-alignment: center;
        overflow: elide;
    }
    @children
}

component EmptyState inherits VerticalLayout {
    in property <string> icon;
    in property <string> title;
    in property <string> text;
    alignment: center;
    spacing: 10px;
    padding: 32px;
    Rectangle {
        height: 96px;
        Rectangle {
            width: 96px;
            height: 96px;
            border-radius: 48px * Palette.round;
            background: Palette.accent-soft;
            Icon {
                commands: root.icon;
                size: 44px;
                tint: Palette.accent.brighter(60%);
            }
        }
    }
    if root.title != "": Text {
        text: root.title;
        color: Palette.text;
        font-size: 18px;
        font-weight: 700;
        horizontal-alignment: center;
    }
    Text {
        text: root.text;
        color: Palette.muted;
        font-size: 14px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    @children
}

component SourceBadge inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    height: 30px;
    border-radius: 15px * Palette.round;
    background: root.tint.with-alpha(0.18);
    border-width: 1px;
    border-color: root.tint.with-alpha(0.5);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            color: root.tint.brighter(40%);
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

component LibraryPage inherits VerticalLayout {
    in property <bool> wide;
    property <bool> in-group: State.group-title != "";
    property <bool> showing-tracks: State.lib-view == 0 || in-group;
    property <length> pad: wide ? 24px : 16px;
    if !root.in-group: PageTitle {
        title: "Biblioteca";
        logo: !root.wide;
        pad: root.pad;
        IconButton {
            icon: Icons.refresh;
            tint: Palette.muted;
            y: (parent.height - self.height) / 2;
            clicked => { State.rescan(); }
        }
    }
    if !root.in-group: HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        InputField {
            placeholder-text: "Canciones, artistas o álbumes";
            text <=> State.lib-query;
            edited(text) => { State.lib-filter(text); }
        }
    }
    if !root.in-group: Flickable {
        height: 60px;
        content-width: chips.preferred-width;
        chips := HorizontalLayout {
            padding-top: 12px;
            padding-bottom: 12px;
            padding-left: root.pad;
            padding-right: root.pad;
            spacing: 8px;
            for name[i] in ["Canciones", "Artistas", "Álbumes", "Listas"]: Chip {
                text: name;
                active: State.lib-view == i;
                clicked => {
                    State.lib-view = i;
                    State.lib-view-changed(i);
                }
            }
        }
    }
    if root.in-group: VerticalLayout {
        padding-left: root.pad;
        padding-right: root.pad - 8px;
        padding-bottom: 14px;
        spacing: 8px;
        HorizontalLayout {
            height: 52px;
            IconButton {
                icon: Icons.back;
                y: (parent.height - self.height) / 2;
                clicked => { State.group-back(); }
            }
            Rectangle { }
            IconButton {
                icon: Icons.more;
                y: (parent.height - self.height) / 2;
                clicked => { State.current-group-menu(); }
            }
        }
        HorizontalLayout {
            spacing: root.wide ? 24px : 16px;
            Cover {
                width: root.wide ? 190px : 128px;
                height: self.width;
                source: State.group-art;
                has-image: State.has-group-art;
                icon: State.lib-view == 1 ? Icons.person : State.lib-view == 2 ? Icons.album : Icons.list;
                border-radius: State.lib-view == 1 ? self.width / 2 : 12px;
                drop-shadow-blur: 20px;
                drop-shadow-color: #00000090;
            }
            VerticalLayout {
                alignment: center;
                spacing: 6px;
                Text {
                    text: State.lib-view == 1 ? "ARTISTA" : State.lib-view == 2 ? "ÁLBUM" : "LISTA";
                    color: Palette.accent.brighter(60%);
                    font-size: 11px;
                    font-weight: 800;
                    letter-spacing: 1.5px;
                }
                Text {
                    text: State.group-title;
                    color: Palette.text;
                    font-size: root.wide ? 30px : 22px;
                    font-weight: 800;
                    wrap: word-wrap;
                    overflow: elide;
                    max-height: root.wide ? 80px : 60px;
                }
                Text {
                    text: State.library-status;
                    color: Palette.muted;
                    font-size: 13px;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    padding-top: 6px;
                    PillButton {
                        text: "Reproducir";
                        icon: Icons.play;
                        clicked => { State.play-all(false); }
                    }
                    IconButton {
                        icon: Icons.shuffle;
                        filled: true;
                        fill: Palette.surface-2;
                        width: 40px;
                        height: 40px;
                        icon-size: 20px;
                        clicked => { State.play-all(true); }
                    }
                }
            }
        }
    }
    if !root.in-group && State.lib-view == 0 && State.tracks.length > 0: HorizontalLayout {
        padding-left: root.pad;
        padding-bottom: 8px;
        spacing: 8px;
        alignment: start;
        PillButton {
            text: "Reproducir";
            icon: Icons.play;
            clicked => { State.play-all(false); }
        }
        PillButton {
            text: "Aleatorio";
            icon: Icons.shuffle;
            primary: false;
            clicked => { State.play-all(true); }
        }
        if root.width >= 400px: Text {
            text: State.library-status;
            color: Palette.muted;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if State.lib-view == 3 && !root.in-group: HorizontalLayout {
        padding-left: root.pad;
        padding-bottom: 12px;
        alignment: start;
        PillButton {
            text: "Nueva lista";
            icon: Icons.add;
            primary: false;
            clicked => { State.name-dialog-open = true; }
        }
    }
    if root.showing-tracks && State.tracks.length == 0: EmptyState {
        vertical-stretch: 1;
        icon: Icons.library;
        title: State.library-status != "" ? "" : "Tu música aparece acá";
        text: State.library-status != "" ? State.library-status : "Buscá y descargá música en Buscar o copiá archivos a la carpeta Música.";
    }
    if root.showing-tracks && State.tracks.length > 0: ListView {
        vertical-stretch: 1;
        for item[i] in State.tracks: ListRow {
            title: item.title;
            subtitle: item.subtitle;
            trailing: item.trailing;
            highlighted: item.playing;
            animate-eq: item.playing && State.playing;
            art: item.art;
            has-art: item.has-art;
            side-padding: root.pad;
            clicked => { State.track-clicked(i); }
            more => { State.track-menu(i); }
        }
    }
    if !root.showing-tracks && State.groups.length == 0: EmptyState {
        vertical-stretch: 1;
        icon: State.lib-view == 1 ? Icons.person : State.lib-view == 2 ? Icons.album : Icons.list;
        text: State.lib-view == 3 ? "Creá una lista o guardá una playlist de Spotify o YouTube." : "Todavía no hay nada acá.";
    }
    if !root.showing-tracks && State.groups.length > 0: Flickable {
        vertical-stretch: 1;
        property <length> gap: 14px;
        property <int> cols: max(2, floor((self.width - 2 * root.pad + gap) / (root.wide ? 200px : 160px)));
        property <length> cw: (self.width - 2 * root.pad - (cols - 1) * gap) / cols;
        property <length> ch: cw + 60px;
        content-height: ceil(State.groups.length / cols) * (ch + gap) + 24px;
        for item[i] in State.groups: Card {
            x: root.pad + mod(i, parent.cols) * (parent.cw + parent.gap);
            y: 4px + floor(i / parent.cols) * (parent.ch + parent.gap);
            width: parent.cw;
            height: parent.ch;
            title: item.name;
            subtitle: item.info;
            art: item.art;
            has-art: item.has-art;
            round: State.lib-view == 1;
            icon: State.lib-view == 1 ? Icons.person : State.lib-view == 2 ? Icons.album : Icons.list;
            clicked => { State.group-clicked(i); }
            more => { State.group-menu(i); }
        }
    }
}

component SearchPage inherits VerticalLayout {
    in property <bool> wide;
    property <length> pad: wide ? 24px : 16px;
    PageTitle {
        title: "Buscar";
        pad: root.pad;
    }
    HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        spacing: 8px;
        InputField {
            placeholder-text: "Canción, artista o link";
            text <=> State.online-query;
            accepted(text) => { State.online-search(text); }
        }
        IconButton {
            icon: Icons.search;
            filled: true;
            accessible-role: button;
            accessible-label: "Buscar";
            accessible-action-default => { State.online-search(State.online-query); }
            width: 46px;
            height: 46px;
            clicked => { State.online-search(State.online-query); }
        }
    }
    if State.online-busy || State.online-status != "": HorizontalLayout {
        padding-top: 12px;
        padding-bottom: 6px;
        padding-left: root.pad;
        padding-right: root.pad;
        spacing: 10px;
        height: 58px;
        if State.online-busy: Spinner {
            indeterminate: true;
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: State.online-status;
            color: Palette.muted;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
        if State.online.length > 1: PillButton {
            text: "Bajar todo";
            icon: Icons.download;
            horizontal-stretch: 0;
            clicked => { State.online-download-all(); }
        }
    }
    if State.online.length == 0: EmptyState {
        vertical-stretch: 1;
        icon: Icons.search;
        title: "Encontrá cualquier canción";
        text: "Buscá en YouTube o pegá un link de una canción, álbum o playlist.";
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            SourceBadge {
                text: "YouTube";
                tint: #ff3b3b;
            }
            SourceBadge {
                text: "Spotify";
                tint: #1db954;
            }
            SourceBadge {
                text: "Apple Music";
                tint: #fa2d48;
            }
        }
    }
    if State.online.length > 0: ListView {
        vertical-stretch: 1;
        for item[i] in State.online: Rectangle {
            height: 68px;
            HorizontalLayout {
                padding-left: root.pad;
                padding-right: root.pad - 8px;
                spacing: 12px;
                Cover {
                    width: 52px;
                    height: 52px;
                    y: (parent.height - self.height) / 2;
                    source: item.art;
                    has-image: item.has-art;
                    border-radius: 6px * Palette.round;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    Text {
                        text: item.title;
                        color: Palette.text;
                        font-size: 15px;
                        font-weight: 500;
                        overflow: elide;
                    }
                    Text {
                        text: item.subtitle;
                        color: Palette.muted;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                if item.state == 0 || item.state == 4: IconButton {
                    icon: item.state == 4 ? Icons.refresh : Icons.download;
                    tint: item.state == 4 ? Palette.danger : Palette.text;
                    filled: item.state == 0;
                    fill: Palette.surface-2;
                    y: (parent.height - self.height) / 2;
                    clicked => { State.online-download(i); }
                }
                if item.state == 1 || item.state == 2: Spinner {
                    indeterminate: true;
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                }
                if item.state == 3: Rectangle {
                    width: 44px;
                    Icon {
                        commands: Icons.check;
                        tint: Palette.ok;
                    }
                }
            }
        }
    }
}

component DownloadsPage inherits VerticalLayout {
    in property <bool> wide;
    property <length> pad: wide ? 24px : 16px;
    PageTitle {
        title: "Descargas";
        pad: root.pad;
        if State.downloads.length > 0: PillButton {
            text: "Limpiar";
            primary: false;
            y: (parent.height - self.height) / 2;
            horizontal-stretch: 0;
            clicked => { State.clear-downloads(); }
        }
        Rectangle { width: 8px; }
    }
    if State.downloads.length == 0: EmptyState {
        vertical-stretch: 1;
        icon: Icons.download;
        title: "Sin descargas";
        text: "Se guardan en " + State.download-dir + " y se agregan solas a tu biblioteca.";
    }
    if State.downloads.length > 0: ListView {
        vertical-stretch: 1;
        for item in State.downloads: Rectangle {
            height: 76px;
            Rectangle {
                x: root.pad;
                y: 4px;
                width: parent.width - 2 * root.pad;
                height: parent.height - 8px;
                border-radius: 12px * Palette.round;
                background: Palette.surface;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 14px;
                    spacing: 12px;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 20px * Palette.round;
                        background: item.state == 3 ? Palette.danger.with-alpha(0.18) : item.state == 2 ? Palette.ok.with-alpha(0.18) : Palette.accent-soft;
                        Icon {
                            commands: item.state == 3 ? Icons.error : item.state == 2 ? Icons.check : Icons.download;
                            tint: item.state == 3 ? Palette.danger : item.state == 2 ? Palette.ok : Palette.accent.brighter(60%);
                            size: 20px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 5px;
                        Text {
                            text: item.title;
                            color: Palette.text;
                            font-size: 14px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: item.status;
                            color: item.state == 3 ? Palette.danger : Palette.muted;
                            font-size: 12px;
                            overflow: elide;
                        }
                        if item.state < 2: Rectangle {
                            height: 4px;
                            border-radius: 2px * Palette.round;
                            background: Palette.overlay;
                            Rectangle {
                                x: 0;
                                width: parent.width * item.progress;
                                background: Palette.accent;
                                border-radius: 2px * Palette.round;
                                animate width { duration: 300ms; }
                            }
                        }
                    }
                }
            }
        }
    }
}

component SettingsPage inherits VerticalLayout {
    in property <bool> wide;
    property <length> pad: wide ? 24px : 16px;
    PageTitle {
        title: "Ajustes";
        pad: root.pad;
    }
    Flickable {
        vertical-stretch: 1;
        content-width: self.width;
        content-height: body.preferred-height;
        body := VerticalLayout {
            width: parent.width;
            padding-left: root.pad;
            padding-right: root.pad;
            padding-bottom: 24px;
            spacing: 10px;
            alignment: start;
            Text {
                text: "Carpeta de descargas";
                color: Palette.text;
                font-size: 16px;
                font-weight: 700;
            }
            Rectangle {
                border-radius: 12px * Palette.round;
                background: Palette.surface;
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 10px;
                        Icon {
                            commands: Icons.folder;
                            tint: Palette.accent.brighter(60%);
                            width: 24px;
                        }
                        Text {
                            horizontal-stretch: 1;
                            min-width: 1px;
                            text: State.download-dir;
                            color: Palette.muted;
                            font-size: 13px;
                            wrap: char-wrap;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        PillButton {
                            text: "Cambiar carpeta";
                            accessible-role: button;
                            accessible-label: "Cambiar carpeta";
                            accessible-action-default => { State.change-download-dir(); }
                            clicked => { State.change-download-dir(); }
                        }
                    }
                }
            }
            Text {
                text: "Podés usar la memoria interna, la tarjeta SD u otra carpeta.";
                color: Palette.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
            Rectangle { height: 8px; }
            Text {
                text: "Ecualizador";
                color: Palette.text;
                font-size: 16px;
                font-weight: 700;
            }
            Rectangle {
                border-radius: 12px * Palette.round;
                background: Palette.surface;
                VerticalLayout {
                    padding: 14px;
                    spacing: 6px;
                    Flickable {
                        height: 36px;
                        content-width: presets.preferred-width;
                        presets := HorizontalLayout {
                            spacing: 8px;
                            for name[i] in State.eq-presets: Chip {
                                text: name;
                                active: State.eq-preset == i;
                                clicked => { State.set-eq-preset(i); }
                            }
                        }
                    }
                    for gain[i] in State.eq: HorizontalLayout {
                        spacing: 10px;
                        Text {
                            width: 54px;
                            text: ["60 Hz", "230 Hz", "910 Hz", "3,6 kHz", "12 kHz"][i];
                            color: Palette.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Bar {
                            horizontal-stretch: 1;
                            value: gain + 12;
                            maximum: 24;
                            fill: Palette.accent;
                            accessible-role: slider;
                            accessible-label: "Banda " + (i + 1);
                            accessible-value: gain;
                            released(v) => { State.set-eq(i, v - 12); }
                        }
                        Text {
                            width: 46px;
                            text: (gain > 0 ? "+" : "") + round(gain) + " dB";
                            color: Palette.text;
                            font-size: 12px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            Rectangle { height: 8px; }
            Text {
                text: "Tema de color";
                color: Palette.text;
                font-size: 16px;
                font-weight: 700;
            }
            for theme[i] in Palette.themes: Rectangle {
                height: 56px;
                border-radius: 12px * Palette.round;
                background: tta.pressed ? Palette.surface-2 : Palette.surface;
                border-width: Palette.theme == i ? 2px : 0px;
                border-color: Palette.accent;
                accessible-role: button;
                accessible-label: "Tema " + theme.name;
                accessible-action-default => { State.set-theme(i); }
                tta := TouchArea {
                    clicked => { State.set-theme(i); }
                }
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 14px * Palette.round;
                        background: @linear-gradient(135deg, theme.accent 0%, theme.accent 50%, theme.bg-2 50%, theme.bg 100%);
                        border-width: 3px;
                        border-color: theme.surface-3;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: theme.name;
                        color: Palette.text;
                        font-size: 15px;
                        font-weight: Palette.theme == i ? 700 : 500;
                        vertical-alignment: center;
                    }
                    if Palette.theme == i: Icon {
                        commands: Icons.check;
                        tint: Palette.accent;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }
    }
}

component QueuePage inherits VerticalLayout {
    in property <bool> wide;
    property <length> pad: wide ? 24px : 16px;
    PageTitle {
        title: "Cola";
        pad: root.pad;
    }
    if State.queue.length == 0: EmptyState {
        vertical-stretch: 1;
        icon: Icons.queue;
        title: "La cola está vacía";
        text: "Tocá una canción de tu biblioteca para empezar.";
    }
    if State.queue.length > 0: ListView {
        vertical-stretch: 1;
        for item[i] in State.queue: Rectangle {
            height: 66px;
            ListRow {
                title: item.title;
                subtitle: item.subtitle;
                highlighted: item.playing;
                animate-eq: item.playing && State.playing;
                art: item.art;
                has-art: item.has-art;
                more => { State.queue-menu(i); }
                side-padding: root.pad;
                clicked => { State.queue-jump(i); }
            }
        }
    }
}

component MiniPlayer inherits Rectangle {
    callback open();
    in property <bool> show-next;
    height: 72px;
    Rectangle {
        x: 8px;
        y: 4px;
        width: parent.width - 16px;
        height: parent.height - 8px;
        border-radius: 12px * Palette.round;
        clip: true;
        background: Palette.tint(State.now-tint);
        animate background { duration: 500ms; }
        TouchArea {
            clicked => { root.open(); }
        }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 4px;
            spacing: 10px;
            Cover {
                width: 46px;
                height: 46px;
                y: (parent.height - self.height) / 2;
                source: State.now-cover;
                has-image: State.has-cover;
                border-radius: 6px * Palette.round;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: State.now-title;
                    color: Palette.text;
                    font-size: 14px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: State.now-artist;
                    color: Palette.muted;
                    font-size: 12px;
                    overflow: elide;
                }
            }
            IconButton {
                icon: State.current-fav ? Icons.heart : Icons.heart-outline;
                tint: State.current-fav ? Palette.accent.brighter(60%) : Palette.text;
                icon-size: 22px;
                y: (parent.height - self.height) / 2;
                clicked => { State.toggle-fav(); }
            }
            IconButton {
                icon: State.playing ? Icons.pause : Icons.play;
                icon-size: 30px;
                y: (parent.height - self.height) / 2;
                clicked => { State.toggle-play(); }
            }
            if root.show-next: IconButton {
                icon: Icons.next;
                y: (parent.height - self.height) / 2;
                clicked => { State.next(); }
            }
        }
        Rectangle {
            x: 10px;
            y: parent.height - 3px;
            width: parent.width - 20px;
            height: 2px;
            border-radius: 1px * Palette.round;
            background: Palette.overlay;
            Rectangle {
                x: 0;
                width: parent.width * (State.duration > 0 ? min(1, State.position / State.duration) : 0);
                background: Palette.text;
            }
        }
    }
}

component PlayerControls inherits VerticalLayout {
    in property <bool> compact;
    alignment: center;
    spacing: compact ? 4px : 12px;
    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Text {
                text: State.now-title;
                color: Palette.text;
                font-size: root.compact ? 18px : 24px;
                font-weight: 800;
                overflow: elide;
            }
            Text {
                text: State.now-artist;
                color: Palette.muted;
                font-size: root.compact ? 13px : 16px;
                overflow: elide;
            }
        }
        IconButton {
            icon: State.current-fav ? Icons.heart : Icons.heart-outline;
            tint: State.current-fav ? Palette.accent.brighter(60%) : Palette.text;
            y: (parent.height - self.height) / 2;
            clicked => { State.toggle-fav(); }
        }
    }
    VerticalLayout {
        Bar {
            value: State.position;
            maximum: State.duration;
            released(v) => { State.seek(v); }
        }
        HorizontalLayout {
            Text {
                text: State.position-text;
                color: Palette.muted;
                font-size: 12px;
            }
            Text {
                text: State.duration-text;
                color: Palette.muted;
                font-size: 12px;
                horizontal-alignment: right;
            }
        }
    }
    HorizontalLayout {
        alignment: space-between;
        IconButton {
            icon: Icons.shuffle;
            tint: State.shuffle ? Palette.accent.brighter(60%) : Palette.muted;
            y: (parent.height - self.height) / 2;
            clicked => { State.toggle-shuffle(); }
        }
        IconButton {
            icon: Icons.prev;
            icon-size: root.compact ? 30px : 38px;
            width: 56px;
            height: 56px;
            y: (parent.height - self.height) / 2;
            clicked => { State.prev(); }
        }
        IconButton {
            icon: State.playing ? Icons.pause : Icons.play;
            icon-size: root.compact ? 32px : 40px;
            tint: Palette.bg;
            filled: true;
            fill: Palette.text;
            width: root.compact ? 60px : 76px;
            height: self.width;
            clicked => { State.toggle-play(); }
        }
        IconButton {
            icon: Icons.next;
            icon-size: root.compact ? 30px : 38px;
            width: 56px;
            height: 56px;
            y: (parent.height - self.height) / 2;
            clicked => { State.next(); }
        }
        IconButton {
            icon: State.repeat-mode == 2 ? Icons.repeat-one : Icons.repeat;
            tint: State.repeat-mode > 0 ? Palette.accent.brighter(60%) : Palette.muted;
            y: (parent.height - self.height) / 2;
            clicked => { State.cycle-repeat(); }
        }
    }
    HorizontalLayout {
        spacing: 10px;
        Icon {
            commands: Icons.volume;
            tint: Palette.muted;
            size: 20px;
            y: (parent.height - self.height) / 2;
        }
        Bar {
            value: State.volume;
            maximum: 1;
            released(v) => { State.set-volume(v); }
        }
    }
}

component BigCover inherits Rectangle {
    in property <length> max-side: 560px;
    property <length> side: min(self.width, self.height, root.max-side) * (State.playing ? 1 : 0.84);
    Cover {
        width: root.side;
        height: root.side;
        source: State.now-cover;
        has-image: State.has-cover;
        border-radius: 14px * Palette.round;
        drop-shadow-blur: 30px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000a0;
        animate width, height { duration: 350ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
}

component FullPlayer inherits Rectangle {
    callback close();
    in property <length> top-inset;
    in property <length> bottom-inset;
    in property <length> left-inset;
    in property <length> right-inset;
    property <bool> landscape: self.width > self.height * 1.1;
    background: @linear-gradient(180deg, Palette.tint(State.now-tint) 0%, Palette.tint-deep(State.now-tint) 55%, Palette.bg 100%);
    TouchArea { }
    VerticalLayout {
        padding-top: root.top-inset + 8px;
        padding-bottom: root.bottom-inset + 16px;
        padding-left: root.left-inset + 20px;
        padding-right: root.right-inset + 20px;
        spacing: 12px;
        HorizontalLayout {
            IconButton {
                icon: Icons.collapse;
                icon-size: 30px;
                clicked => { root.close(); }
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: "REPRODUCIENDO";
                    color: Palette.muted;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 1.5px;
                    horizontal-alignment: center;
                }
                Text {
                    text: State.now-album;
                    color: Palette.text;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
            IconButton {
                icon: Icons.more;
                clicked => { State.current-menu(); }
            }
        }
        if !root.landscape: VerticalLayout {
            vertical-stretch: 1;
            spacing: 20px;
            BigCover {
                vertical-stretch: 1;
            }
            HorizontalLayout {
                alignment: center;
                vertical-stretch: 0;
                PlayerControls {
                    horizontal-stretch: 1;
                    max-width: 600px;
                }
            }
        }
        if root.landscape: HorizontalLayout {
            vertical-stretch: 1;
            spacing: 32px;
            BigCover {
                width: min(parent.height, parent.width * 0.45);
            }
            VerticalLayout {
                alignment: center;
                PlayerControls {
                    compact: root.height < 500px;
                }
            }
        }
    }
}

component NowPanel inherits Rectangle {
    callback expand();
    in property <length> top-inset;
    in property <length> bottom-inset;
    background: @linear-gradient(180deg, Palette.tint(State.now-tint) 0%, Palette.surface 65%);
    VerticalLayout {
        x: 0;
        width: parent.width;
        height: parent.height;
        padding: 20px;
        padding-top: root.top-inset + 12px;
        padding-bottom: root.bottom-inset + 12px;
        spacing: 14px;
        HorizontalLayout {
            Text {
                text: "Reproduciendo";
                color: Palette.text;
                font-size: 16px;
                font-weight: 800;
                vertical-alignment: center;
            }
            IconButton {
                icon: Icons.open;
                clicked => { root.expand(); }
            }
            IconButton {
                icon: Icons.more;
                clicked => { State.current-menu(); }
            }
        }
        Rectangle {
            height: min(self.width, root.height * 0.36);
            Cover {
                width: parent.height;
                height: parent.height;
                source: State.now-cover;
                has-image: State.has-cover;
                border-radius: 12px * Palette.round;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000090;
            }
            TouchArea {
                clicked => { root.expand(); }
            }
        }
        PlayerControls {
            compact: true;
        }
        Text {
            text: "A continuación";
            color: Palette.muted;
            font-size: 13px;
            font-weight: 700;
        }
        ListView {
            vertical-stretch: 1;
            for item[i] in State.queue: ListRow {
                title: item.title;
                subtitle: item.subtitle;
                highlighted: item.playing;
                animate-eq: item.playing && State.playing;
                art: item.art;
                has-art: item.has-art;
                more => { State.queue-menu(i); }
                side-padding: 0px;
                clicked => { State.queue-jump(i); }
            }
        }
    }
}

component Sheet inherits Rectangle {
    in property <length> bottom-inset;
    in property <bool> wide;
    in property <string> title;
    in property <[string]> options;
    callback dismiss();
    callback picked(int);
    background: #000000a8;
    TouchArea {
        clicked => { root.dismiss(); }
    }
    Rectangle {
        width: root.wide ? min(440px, parent.width - 48px) : parent.width;
        height: min(parent.height - 80px, 72px + root.options.length * 54px + (root.wide ? 12px : root.bottom-inset + 12px));
        x: (parent.width - self.width) / 2;
        y: root.wide ? (parent.height - self.height) / 2 : parent.height - self.height;
        background: Palette.surface;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
        border-bottom-left-radius: root.wide ? 20px : 0px;
        border-bottom-right-radius: root.wide ? 20px : 0px;
        clip: true;
        TouchArea { }
        VerticalLayout {
            padding-top: 10px;
            padding-bottom: root.wide ? 12px : root.bottom-inset + 12px;
            if !root.wide: Rectangle {
                height: 6px;
                Rectangle {
                    width: 36px;
                    height: 4px;
                    border-radius: 2px * Palette.round;
                    background: Palette.overlay;
                }
            }
            Text {
                height: 50px;
                text: root.title;
                color: Palette.muted;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: center;
                overflow: elide;
            }
            Rectangle {
                height: 1px;
                background: Palette.stroke;
            }
            ListView {
                vertical-stretch: 1;
                for opt[i] in root.options: Rectangle {
                    height: 54px;
                    background: ota.pressed ? Palette.stroke : transparent;
                    ota := TouchArea {
                        clicked => { root.picked(i); }
                    }
                    Text {
                        x: 24px;
                        width: parent.width - 48px;
                        text: opt;
                        color: Palette.text;
                        font-size: 16px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

component NameDialog inherits Rectangle {
    callback dismiss();
    callback create(string);
    property <string> name;
    background: #000000a8;
    TouchArea {
        clicked => { root.dismiss(); }
    }
    Rectangle {
        width: min(parent.width - 48px, 400px);
        height: 190px;
        x: (parent.width - self.width) / 2;
        y: parent.height * 0.22;
        background: Palette.surface;
        border-radius: 20px * Palette.round;
        TouchArea { }
        VerticalLayout {
            padding: 20px;
            spacing: 16px;
            Text {
                text: "Nueva lista";
                color: Palette.text;
                font-size: 20px;
                font-weight: 800;
            }
            InputField {
                placeholder-text: "Nombre de la lista";
                text <=> root.name;
                accepted(text) => { root.create(text); }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                PillButton {
                    text: "Cancelar";
                    primary: false;
                    clicked => { root.dismiss(); }
                }
                PillButton {
                    text: "Crear";
                    clicked => { root.create(root.name); }
                }
            }
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    in property <int> badge;
    callback clicked();
    TouchArea {
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        Rectangle {
            height: 30px;
            Rectangle {
                width: root.active ? 60px : 30px;
                height: 30px;
                border-radius: 15px * Palette.round;
                background: root.active ? Palette.accent-soft : transparent;
                animate width, background { duration: 180ms; }
            }
            Icon {
                commands: root.icon;
                tint: root.active ? Palette.text : Palette.muted;
            }
            if root.badge > 0: Rectangle {
                x: parent.width / 2 + 6px;
                y: -2px;
                width: 18px;
                height: 18px;
                border-radius: 9px * Palette.round;
                background: Palette.accent;
                Text {
                    text: root.badge;
                    color: Palette.text;
                    font-size: 10px;
                    font-weight: 700;
                }
            }
        }
        Text {
            text: root.label;
            color: root.active ? Palette.text : Palette.muted;
            font-size: 11px;
            font-weight: root.active ? 700 : 500;
            horizontal-alignment: center;
        }
    }
}

export { Palette }

export component AppWindow inherits Window {
    in-out property <int> current-tab: 0;
    in-out property <bool> player-open: false;
    property <length> top-inset: self.safe-area-insets.top;
    property <length> bottom-inset: self.safe-area-insets.bottom;
    property <length> left-inset: self.safe-area-insets.left;
    property <length> right-inset: self.safe-area-insets.right;
    property <bool> wide: self.width >= 600px;
    property <bool> side-panel: self.width >= 1000px && State.has-current;
    property <bool> mini: State.has-current && !root.side-panel;
    property <[{icon: string, label: string}]> tabs: [
        { icon: Icons.library, label: "Biblioteca" },
        { icon: Icons.search, label: "Buscar" },
        { icon: Icons.download, label: "Descargas" },
        { icon: Icons.queue, label: "Cola" },
        { icon: Icons.settings, label: "Ajustes" },
    ];
    title: "Tein";
    background: Palette.backdrop;
    preferred-width: 400px;
    preferred-height: 820px;
    default-font-size: 14px;

    HorizontalLayout {
        x: 0;
        width: parent.width;
        height: parent.height;
        padding-left: root.left-inset;
        padding-right: root.right-inset;
        if root.wide: Rectangle {
            width: 92px;
            background: Palette.surface;
            VerticalLayout {
                padding-top: root.top-inset + 18px;
                padding-bottom: root.bottom-inset + 12px;
                spacing: 6px;
                alignment: start;
                Rectangle {
                    height: 64px;
                    Image {
                        source: @image-url("../docs/logo.png");
                        width: 44px;
                        height: 44px;
                    }
                }
                for tab[i] in root.tabs: NavItem {
                    height: 72px;
                    icon: tab.icon;
                    label: tab.label;
                    active: root.current-tab == i;
                    badge: i == 2 ? State.active-downloads : 0;
                    clicked => { root.current-tab = i; }
                }
            }
        }
        VerticalLayout {
            padding-top: root.top-inset;
            Rectangle {
                vertical-stretch: 1;
                if root.current-tab == 0: LibraryPage { wide: root.wide; }
                if root.current-tab == 1: SearchPage { wide: root.wide; }
                if root.current-tab == 2: DownloadsPage { wide: root.wide; }
                if root.current-tab == 3: QueuePage { wide: root.wide; }
                if root.current-tab == 4: SettingsPage { wide: root.wide; }
            }
            if root.mini: MiniPlayer {
                show-next: root.wide;
                open => { root.player-open = true; }
            }
            if !root.wide: Rectangle {
                height: 64px + root.bottom-inset;
                background: Palette.bar;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Palette.stroke;
                }
                HorizontalLayout {
                    padding-bottom: root.bottom-inset;
                    for tab[i] in root.tabs: NavItem {
                        icon: tab.icon;
                        label: tab.label;
                        active: root.current-tab == i;
                        badge: i == 2 ? State.active-downloads : 0;
                        clicked => { root.current-tab = i; }
                    }
                }
            }
            if root.wide: Rectangle { height: root.bottom-inset; }
        }
        if root.side-panel: NowPanel {
            width: 360px;
            top-inset: root.top-inset;
            bottom-inset: root.bottom-inset;
            expand => { root.player-open = true; }
        }
    }

    FullPlayer {
        x: 0;
        y: root.player-open && State.has-current ? 0 : root.height;
        width: root.width;
        height: root.height;
        visible: self.y < root.height;
        top-inset: root.top-inset;
        bottom-inset: root.bottom-inset;
        left-inset: root.left-inset;
        right-inset: root.right-inset;
        close => { root.player-open = false; }
        animate y { duration: 320ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }

    if State.menu-open: Sheet {
        bottom-inset: root.bottom-inset;
        wide: root.wide;
        title: State.menu-title;
        options: State.menu-options;
        dismiss => { State.menu-open = false; }
        picked(i) => {
            State.menu-open = false;
            State.menu-action(i);
        }
    }

    if State.chooser-open: Sheet {
        bottom-inset: root.bottom-inset;
        wide: root.wide;
        title: "Añadir a una lista";
        options: State.playlist-names;
        dismiss => { State.chooser-open = false; }
        picked(i) => {
            State.chooser-open = false;
            State.choose-playlist(i);
        }
    }

    if State.name-dialog-open: NameDialog {
        dismiss => { State.name-dialog-open = false; }
        create(name) => {
            State.name-dialog-open = false;
            State.create-playlist(name);
        }
    }

    if State.edit-open: Rectangle {
        background: #000000b0;
        TouchArea { }
        Rectangle {
            width: min(parent.width - 24px, 440px);
            // Near the top so the keyboard never covers the buttons.
            y: root.top-inset + 16px;
            height: min(State.edit-mode == 0 ? 330px : State.edit-mode == 1 ? 260px : 190px, parent.height - root.top-inset - root.bottom-inset - 16px);
            background: Palette.surface;
            border-radius: 16px * Palette.round;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                Text { text: State.edit-mode == 0 ? "Editar canción" : State.edit-mode == 1 ? "Editar álbum" : State.edit-mode == 2 ? "Editar artista" : "Editar lista"; font-size: 20px; color: Palette.text; }
                Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: fields.preferred-height;
                    fields := VerticalLayout {
                        width: parent.width;
                        spacing: 4px;
                        property <string> main-label: State.edit-mode == 0 ? "Título" : State.edit-mode == 1 ? "Álbum" : State.edit-mode == 2 ? "Artista" : "Nombre";
                        Text { text: fields.main-label; color: Palette.muted; }
                        InputField { accessible-label: fields.main-label; text <=> State.edit-title; enabled: !State.edit-saving; }
                        if State.edit-mode <= 1: Text { text: State.edit-mode == 1 ? "Artista (vacío: no cambiar)" : "Artista"; color: Palette.muted; }
                        if State.edit-mode <= 1: InputField { accessible-label: "Artista"; text <=> State.edit-artist; enabled: !State.edit-saving; }
                        if State.edit-mode == 0: Text { text: "Álbum"; color: Palette.muted; }
                        if State.edit-mode == 0: InputField { accessible-label: "Álbum"; text <=> State.edit-album; enabled: !State.edit-saving; }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    PillButton { text: "Cancelar"; primary: false; clicked => { if !State.edit-saving { State.edit-open = false; } } }
                    PillButton { text: State.edit-saving ? "Guardando…" : "Guardar"; clicked => { State.save-edit(); } }
                }
            }
        }
    }

    if State.toast != "": Rectangle {
        width: min(parent.width - 48px, 480px);
        height: 46px;
        x: (parent.width - self.width) / 2;
        y: parent.height - root.bottom-inset - (root.wide ? 24px : 76px) - (root.mini ? 72px : 0px) - self.height;
        border-radius: 23px * Palette.round;
        background: #33333ff2;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000080;
        Text {
            x: 18px;
            width: parent.width - 36px;
            text: State.toast;
            color: Palette.text;
            font-size: 13px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}
