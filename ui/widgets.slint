import { Palette, Icons } from "theme.slint";
import { LineEdit } from "std-widgets.slint";

export component Icon inherits Path {
    in property <color> tint: Palette.text;
    in property <length> size: 24px;
    fill: tint;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <length> icon-size: 24px;
    in property <color> tint: Palette.text;
    in property <bool> filled: false;
    in property <color> fill: Palette.accent;
    callback clicked();
    width: 44px;
    height: 44px;
    border-radius: self.width / 2 * Palette.round;
    background: filled ? (ta.pressed ? root.fill.darker(20%) : root.fill) : (ta.pressed ? Palette.overlay : transparent);
    animate background { duration: 120ms; }
    Icon {
        commands: root.icon;
        tint: root.tint;
        size: ta.pressed ? root.icon-size * 0.9 : root.icon-size;
        animate size { duration: 120ms; }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Glassy highlight of the Frutiger Aero era.
export component Gloss inherits Rectangle {
    in property <length> radius;
    border-radius: root.radius;
    border-width: 1px;
    border-color: #ffffff50;
    background: @linear-gradient(180deg, #ffffff70 0%, #ffffff18 48%, #ffffff00 52%, #ffffff14 100%);
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 36px;
    border-radius: 18px * Palette.round;
    background: active ? Palette.text : (ta.pressed ? Palette.surface-3 : Palette.surface-2);
    animate background { duration: 160ms; }
    if Palette.gloss: Gloss { radius: root.border-radius; }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: root.text;
            color: root.active ? Palette.bg : Palette.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component PillButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary: true;
    callback clicked();
    height: 40px;
    border-radius: 20px * Palette.round;
    background: primary ? (ta.pressed ? Palette.accent.darker(20%) : Palette.accent) : (ta.pressed ? Palette.surface-3 : Palette.surface-2);
    animate background { duration: 120ms; }
    if Palette.gloss: Gloss { radius: root.border-radius; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 18px;
        spacing: 6px;
        alignment: center;
        if root.icon != "": Icon {
            commands: root.icon;
            tint: root.primary ? Palette.on-accent : Palette.text;
            size: 20px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: root.primary ? Palette.on-accent : Palette.text;
            font-size: 14px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component Cover inherits Rectangle {
    in property <image> source;
    in property <bool> has-image;
    in property <string> icon: Icons.note;
    border-radius: 8px * Palette.round;
    clip: true;
    background: @linear-gradient(135deg, Palette.accent.darker(25%) 0%, Palette.accent.darker(120%).mix(Palette.surface-2, 0.5) 60%, Palette.surface-2 100%);
    if !root.has-image: Icon {
        commands: root.icon;
        size: min(root.width, root.height) * 0.42;
        tint: #ffffffb8;
    }
    if root.has-image: Image {
        source: root.source;
        width: 100%;
        height: 100%;
        image-fit: cover;
    }
}

/// Animated "now playing" bars.
export component EqBars inherits Rectangle {
    in property <bool> active;
    in property <color> bar-color: Palette.accent.brighter(50%);
    width: 18px;
    height: 16px;
    for phase[i] in [0, 110, 230]: Rectangle {
        x: i * 6px;
        width: 4px;
        border-radius: 1px * Palette.round;
        background: root.bar-color;
        height: root.active ? 3px + 13px * abs(sin((animation-tick() / 1ms * 0.5 + phase) * 1deg)) : 4px;
        y: root.height - self.height;
    }
}

export component Bar inherits Rectangle {
    in property <float> value;
    in property <float> maximum: 1;
    in property <color> fill: Palette.text;
    callback released(float);
    out property <bool> dragging: ta.pressed;
    property <float> drag-value;
    property <float> shown: ta.pressed ? drag-value : value;
    property <float> frac: max(0, min(1, shown / max(maximum, 0.0001)));
    height: 32px;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: ta.pressed ? 6px : 4px;
        border-radius: self.height / 2 * Palette.round;
        background: Palette.overlay;
    }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: parent.width * root.frac;
        height: ta.pressed ? 6px : 4px;
        border-radius: self.height / 2 * Palette.round;
        background: root.fill;
    }
    Rectangle {
        x: parent.width * root.frac - self.width / 2;
        width: ta.pressed ? 18px : 12px;
        height: self.width;
        border-radius: self.width / 2 * Palette.round;
        background: Palette.text;
        animate width { duration: 100ms; }
    }
    ta := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.drag-value = max(0, min(1, self.mouse-x / root.width)) * root.maximum;
            }
            if event.kind == PointerEventKind.up {
                root.released(root.drag-value);
            }
        }
        moved => {
            root.drag-value = max(0, min(1, self.mouse-x / root.width)) * root.maximum;
        }
    }
}

export component InputField inherits LineEdit {
    min-width: 1px;
    preferred-width: 1px;
    horizontal-stretch: 1;
    height: 46px;
}

export component ListRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> trailing;
    in property <bool> highlighted;
    in property <bool> animate-eq;
    in property <image> art;
    in property <bool> has-art;
    in property <string> icon: Icons.note;
    in property <bool> show-more: true;
    in property <length> side-padding: 16px;
    callback clicked();
    callback more();
    height: 66px;
    background: ta.pressed ? Palette.stroke : transparent;
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: root.side-padding;
        padding-right: max(0px, root.side-padding - 8px);
        spacing: 12px;
        Rectangle {
            width: 50px;
            height: 50px;
            y: (parent.height - self.height) / 2;
            Cover {
                width: 100%;
                height: 100%;
                source: root.art;
                has-image: root.has-art;
                icon: root.icon;
                border-radius: 6px * Palette.round;
            }
            if root.highlighted: Rectangle {
                border-radius: 6px * Palette.round;
                background: #00000088;
                EqBars { active: root.animate-eq; }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text {
                text: root.title;
                color: root.highlighted ? Palette.accent.brighter(50%) : Palette.text;
                font-size: 15px;
                font-weight: root.highlighted ? 700 : 500;
                overflow: elide;
            }
            Text {
                text: root.subtitle;
                color: Palette.muted;
                font-size: 12px;
                overflow: elide;
                visible: root.subtitle != "";
            }
        }
        if root.trailing != "": Text {
            width: 52px;
            text: root.trailing;
            color: Palette.muted;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        if root.show-more: IconButton {
            icon: Icons.more;
            accessible-role: button;
            accessible-label: "Opciones de " + root.title;
            accessible-action-default => { root.more(); }
            width: 48px;
            height: 48px;
            tint: Palette.text;
            icon-size: 22px;
            y: (parent.height - self.height) / 2;
            clicked => { root.more(); }
        }
        if !root.show-more: Rectangle { width: 12px; }
    }
}

/// Square (or round) cover card for album, artist and playlist grids.
export component Card inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <image> art;
    in property <bool> has-art;
    in property <string> icon: Icons.album;
    in property <bool> round;
    in property <bool> show-more: true;
    callback clicked();
    callback more();
    opacity: ta.pressed ? 0.75 : 1;
    animate opacity { duration: 100ms; }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    Cover {
        x: 0;
        y: 0;
        width: root.width;
        height: root.width;
        source: root.art;
        has-image: root.has-art;
        icon: root.icon;
        border-radius: root.round ? self.width / 2 : 10px;
    }
    if root.show-more: IconButton {
        x: root.width - self.width - 4px;
        y: root.width - self.height - 4px;
        width: 36px;
        height: 36px;
        icon: Icons.more;
        icon-size: 20px;
        filled: true;
        fill: #000000a0;
        clicked => { root.more(); }
    }
    Text {
        x: 0;
        y: root.width + 8px;
        width: root.width;
        text: root.title;
        color: Palette.text;
        font-size: 14px;
        font-weight: 600;
        overflow: elide;
        horizontal-alignment: root.round ? center : left;
    }
    Text {
        x: 0;
        y: root.width + 28px;
        width: root.width;
        text: root.subtitle;
        color: Palette.muted;
        font-size: 12px;
        overflow: elide;
        horizontal-alignment: root.round ? center : left;
    }
}
