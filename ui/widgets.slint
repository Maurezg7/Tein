import { Palette, Icons } from "theme.slint";

export component Icon inherits Path {
    in property <color> tint: Palette.text;
    in property <length> size: 24px;
    fill: tint;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <length> icon-size: 24px;
    in property <color> tint: Palette.text;
    in property <bool> filled: false;
    callback clicked();
    width: 44px;
    height: 44px;
    border-radius: self.width / 2;
    background: filled ? (ta.pressed ? Palette.accent.darker(20%) : Palette.accent) : (ta.pressed ? #ffffff1f : transparent);
    Icon {
        commands: root.icon;
        tint: root.tint;
        size: root.icon-size;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 34px;
    border-radius: 17px;
    background: active ? Palette.accent : (ta.pressed ? Palette.surface-2.brighter(20%) : Palette.surface-2);
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            color: Palette.text;
            font-size: 13px;
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component PillButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary: true;
    callback clicked();
    height: 38px;
    border-radius: 19px;
    background: primary ? (ta.pressed ? Palette.accent.darker(20%) : Palette.accent) : (ta.pressed ? Palette.surface-2.brighter(20%) : Palette.surface-2);
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        spacing: 6px;
        alignment: center;
        if root.icon != "": Icon {
            commands: root.icon;
            size: 20px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: Palette.text;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component Cover inherits Rectangle {
    in property <image> source;
    in property <bool> has-image;
    in property <string> icon: Icons.note;
    border-radius: 8px;
    clip: true;
    background: @linear-gradient(135deg, Palette.accent.darker(30%) 0%, Palette.surface-2 100%);
    if !root.has-image: Icon {
        commands: root.icon;
        size: root.width * 0.45;
        tint: #ffffffb0;
    }
    if root.has-image: Image {
        source: root.source;
        width: 100%;
        height: 100%;
        image-fit: cover;
    }
}

export component Bar inherits Rectangle {
    in property <float> value;
    in property <float> maximum: 1;
    in property <color> fill: Palette.accent;
    callback released(float);
    out property <bool> dragging: ta.pressed;
    property <float> drag-value;
    property <float> shown: ta.pressed ? drag-value : value;
    property <float> frac: max(0, min(1, shown / max(maximum, 0.0001)));
    height: 32px;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: #ffffff2e;
    }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: parent.width * root.frac;
        height: 4px;
        border-radius: 2px;
        background: root.fill;
    }
    Rectangle {
        x: parent.width * root.frac - self.width / 2;
        width: ta.pressed ? 18px : 14px;
        height: self.width;
        border-radius: self.width / 2;
        background: Palette.text;
    }
    ta := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.drag-value = max(0, min(1, self.mouse-x / root.width)) * root.maximum;
            }
            if event.kind == PointerEventKind.up {
                root.released(root.drag-value);
            }
        }
        moved => {
            root.drag-value = max(0, min(1, self.mouse-x / root.width)) * root.maximum;
        }
    }
}

export component ListRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> trailing;
    in property <bool> highlighted;
    in property <string> icon: Icons.note;
    in property <bool> show-more: true;
    callback clicked();
    callback more();
    height: 64px;
    background: ta.pressed ? #ffffff0f : transparent;
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 4px;
        spacing: 12px;
        Cover {
            width: 46px;
            height: 46px;
            y: (parent.height - self.height) / 2;
            icon: root.icon;
            border-radius: 6px;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: root.highlighted ? Palette.accent.brighter(40%) : Palette.text;
                font-size: 15px;
                font-weight: root.highlighted ? 700 : 500;
                overflow: elide;
            }
            Text {
                text: root.subtitle;
                color: Palette.muted;
                font-size: 12px;
                overflow: elide;
                visible: root.subtitle != "";
            }
        }
        Text {
            text: root.trailing;
            color: Palette.muted;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        if root.show-more: IconButton {
            icon: Icons.more;
            tint: Palette.muted;
            icon-size: 22px;
            y: (parent.height - self.height) / 2;
            clicked => { root.more(); }
        }
        if !root.show-more: Rectangle { width: 8px; }
    }
}
