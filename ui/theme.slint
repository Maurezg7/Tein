export struct Theme { name: string, bg: color, surface: color, surface-2: color, surface-3: color, accent: color }

export global Palette {
    in-out property <int> theme: 0;
    out property <[Theme]> themes: [
        { name: "Violeta", bg: #0f0f13, surface: #1a1a21, surface-2: #24242d, surface-3: #30303b, accent: #8b5cf6 },
        { name: "Océano", bg: #0b1118, surface: #141d28, surface-2: #1d2937, surface-3: #283748, accent: #3b82f6 },
        { name: "Esmeralda", bg: #0b120f, surface: #14201a, surface-2: #1d2c25, surface-3: #283a31, accent: #10b981 },
        { name: "Atardecer", bg: #14100c, surface: #211a14, surface-2: #2d241c, surface-3: #3b3026, accent: #f97316 },
        { name: "Rosa", bg: #140d11, surface: #21161c, surface-2: #2d1f27, surface-3: #3b2a33, accent: #ec4899 },
        { name: "Negro puro", bg: #000000, surface: #101012, surface-2: #1a1a1e, surface-3: #26262b, accent: #e5484d },
    ];
    property <Theme> current: themes[min(max(theme, 0), themes.length - 1)];
    out property <color> bg: current.bg;
    out property <color> surface: current.surface;
    out property <color> surface-2: current.surface-2;
    out property <color> surface-3: current.surface-3;
    out property <color> stroke: #ffffff14;
    out property <color> accent: current.accent;
    out property <color> accent-soft: current.accent.with-alpha(0.25);
    out property <color> text: #f4f4f6;
    out property <color> muted: #a0a0ad;
    out property <color> danger: #f87171;
    out property <color> ok: #34d399;
}

