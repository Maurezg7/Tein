        { name: "Capitán Escudo", bg: #12306e, bg-2: #0a1a3e, surface: #1a3e88, surface-2: #244ea6, surface-3: #3060c2, accent: #e02030, text: #ffffff, muted: #b8c8e8, on-accent: #ffffff, round: 0.6, gloss: false, shape: Shapes.shield },
        { name: "Velocista", bg: #c81414, bg-2: #7a0808, surface: #da2020e8, surface-2: #ee3a2a, surface-3: #ff5a40, accent: #ffd60a, text: #ffffff, muted: #ffd0c4, on-accent: #7a0808, round: 0.4, gloss: true, shape: Shapes.bolt },
        { name: "Amazona", bg: #8a1220, bg-2: #0c1e5a, surface: #a01a2ae8, surface-2: #16307a, surface-3: #20409a, accent: #f2c230, text: #fff6dc, muted: #e8b8b0, on-accent: #3a1004, round: 0.5, gloss: true, shape: Shapes.star },
    ];
    property <Theme> current: themes[min(max(theme, 0), themes.length - 1)];
    out property <color> bg: current.bg;
    out property <color> bar: current.bg-2;
    out property <brush> backdrop: @linear-gradient(180deg, current.bg 0%, current.bg-2 100%);
    out property <color> surface: current.surface;
    out property <color> surface-2: current.surface-2;
    out property <color> surface-3: current.surface-3;
    out property <color> stroke: current.text.with-alpha(0.08);
    out property <color> overlay: current.text.with-alpha(0.12);
    out property <color> accent: current.accent;
    out property <color> accent-soft: current.accent.with-alpha(0.25);
    out property <color> text: current.text;
    out property <color> muted: current.muted;
    out property <color> on-accent: current.on-accent;
    // Multiplies corner radii: 1 is round, 0 is square like a classic skin.
    out property <float> round: current.round;
    out property <bool> gloss: current.gloss;
    out property <string> shape: current.shape;
    // Cover-derived colours are dark; light themes need them pastel to keep text readable.
    pure public function tint(c: color) -> color { return current.light ? c.mix(#ffffff, 0.3) : c; }
    pure public function tint-deep(c: color) -> color { return current.light ? c.mix(#ffffff, 0.15) : c.darker(60%); }
    out property <color> danger: #f87171;
    out property <color> ok: #34d399;
}

// Material Design icon paths (Apache 2.0), 24x24 viewbox.
